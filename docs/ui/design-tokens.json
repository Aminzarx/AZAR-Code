{
  "$schema": "AZAR Design System — machine-readable tokens. Authoritative numeric source; see /docs/ui/design-system.md for rationale and usage rules. Do not edit values here without updating design-system.md to match.",
  "meta": {
    "name": "AZAR Design System",
    "version": "2.0.0",
    "foundation": "Material Design 3 structure (https://m3.material.io/), custom \"Minimal Luxury\" palette/shape/elevation",
    "date": "2026-08-09",
    "status": "draft-authoritative",
    "changeLog": "v2.0.0: full visual reset — \"Minimal Luxury\" direction (warm-neutral ivory/ink surfaces + two restrained accents replacing the old cool-gray/near-black Material-generated palette), rounder shape scale, softer/larger-blur elevation, more generous card padding and RTL line-heights. Every token key name is unchanged from v1.1.0 so the change is a value swap, not a schema change. v1.1.0: FINAL UI correction pass before Phase 4 — distinct `warning` token separated from `error`; `iconButton` corrected from a 40px visual size with a merely 'recommended' 48dp hit area to a mandatory 48dp hit area around an unenlarged icon; `color.dark` remains explicitly deferred (unchanged, not populated)."
  },
  "color": {
    "light": {
      "primary": "#1C1B19",
      "on-primary": "#FAF8F5",
      "primary-container": "#2B2A27",
      "on-primary-container": "#C9C4BA",
      "inverse-primary": "#D8D2C4",
      "primary-fixed": "#E3DDD1",
      "primary-fixed-dim": "#C9C4BA",
      "on-primary-fixed": "#2B2A27",
      "on-primary-fixed-variant": "#57534A",
      "secondary": "#8A6D3B",
      "on-secondary": "#FFFFFF",
      "secondary-container": "#F1E6D2",
      "on-secondary-container": "#5C4720",
      "secondary-fixed": "#F1E6D2",
      "secondary-fixed-dim": "#D9C3A0",
      "on-secondary-fixed": "#3D2E12",
      "on-secondary-fixed-variant": "#5C4720",
      "tertiary": "#2F4F3E",
      "on-tertiary": "#FFFFFF",
      "tertiary-container": "#DCEAE1",
      "on-tertiary-container": "#1F3D2E",
      "tertiary-fixed": "#DCEAE1",
      "tertiary-fixed-dim": "#AFC9BB",
      "on-tertiary-fixed": "#12261C",
      "on-tertiary-fixed-variant": "#1F3D2E",
      "error": "#B3261E",
      "on-error": "#FFFFFF",
      "error-container": "#F9DEDC",
      "on-error-container": "#410E0B",
      "success": "#2F6B4F",
      "on-success": "#FFFFFF",
      "success-container": "#DCEFE3",
      "on-success-container": "#1B4632",
      "warning": "#8A5A00",
      "on-warning": "#FFFFFF",
      "warning-container": "#F6E3C2",
      "on-warning-container": "#4A3200",
      "info": "#3D5A73",
      "on-info": "#FFFFFF",
      "info-container": "#E1E9EF",
      "on-info-container": "#263B4C",
      "background": "#FAF8F5",
      "on-background": "#1C1B19",
      "surface": "#FAF8F5",
      "surface-dim": "#E7E3DC",
      "surface-bright": "#FAF8F5",
      "surface-container-lowest": "#FFFFFF",
      "surface-container-low": "#F5F2EC",
      "surface-container": "#EFEBE3",
      "surface-container-high": "#E9E4DA",
      "surface-container-highest": "#E3DDD1",
      "surface-variant": "#E3DDD1",
      "on-surface": "#1C1B19",
      "on-surface-variant": "#57534A",
      "inverse-surface": "#302E2A",
      "inverse-on-surface": "#F5F2EC",
      "outline": "#8A8578",
      "outline-variant": "#D8D2C4",
      "surface-tint": "#8A6D3B"
    },
    "dark": {
      "$status": "NOT DEFINED — flagged gap, see design-system.md §11. No dark palette has been designed. Do not populate this object with guessed values; a dedicated dark-palette design pass is required first."
    },
    "notes": {
      "success": "A distinct deep-emerald hue, deliberately separate from `tertiary` even though both are green-family — `success` is a semantic/functional signal (operation succeeded, positive money state) while `tertiary` is a brand accent; keeping them independently editable matters more than sharing one value would save.",
      "warning": "Use `warning`/`warning-container` for non-fatal caution states — contract approaching expiration, reminder-related caution, restore-flow warnings before the destructive commit step. Reserve `error`/`error-container` strictly for genuine failures — failed operations, invalid input, corrupted data, authentication failure, the destructive commit action itself. See design-system.md §1.",
      "info": "Independent slate-blue hue — no longer aliased to `tertiary` (that alias predates the v2.0.0 palette and no longer makes sense now that `tertiary` is the brand emerald accent)."
    }
  },
  "typography": {
    "ltr": {
      "display":            { "fontFamily": "Geist",      "fontSize": 40, "fontWeight": 600, "lineHeight": 48, "letterSpacing": "-0.02em" },
      "headline-lg":         { "fontFamily": "Geist",      "fontSize": 32, "fontWeight": 600, "lineHeight": 40, "letterSpacing": "-0.02em" },
      "headline-lg-mobile":  { "fontFamily": "Geist",      "fontSize": 24, "fontWeight": 600, "lineHeight": 32, "letterSpacing": "-0.01em" },
      "headline-md":         { "fontFamily": "Geist",      "fontSize": 24, "fontWeight": 500, "lineHeight": 32, "letterSpacing": "-0.01em" },
      "title-md":            { "fontFamily": "Geist",      "fontSize": 18, "fontWeight": 600, "lineHeight": 26, "letterSpacing": "-0.005em" },
      "title-sm":            { "fontFamily": "Geist",      "fontSize": 16, "fontWeight": 600, "lineHeight": 22, "letterSpacing": "0em" },
      "body-lg":             { "fontFamily": "Inter",      "fontSize": 18, "fontWeight": 400, "lineHeight": 28, "letterSpacing": "normal" },
      "body-md":             { "fontFamily": "Inter",      "fontSize": 16, "fontWeight": 400, "lineHeight": 24, "letterSpacing": "normal" },
      "body-sm":             { "fontFamily": "Inter",      "fontSize": 14, "fontWeight": 400, "lineHeight": 20, "letterSpacing": "normal" },
      "label-md":            { "fontFamily": "Geist",      "fontSize": 14, "fontWeight": 500, "lineHeight": 20, "letterSpacing": "0.01em" },
      "label-sm":            { "fontFamily": "Geist",      "fontSize": 12, "fontWeight": 600, "lineHeight": 16, "letterSpacing": "0.02em" },
      "label-sm-mobile":     { "fontFamily": "Geist",      "fontSize": 10, "fontWeight": 600, "lineHeight": 14, "letterSpacing": "0.02em" }
    },
    "rtl": {
      "display-rtl":            { "fontFamily": "Vazirmatn", "fontSize": 40, "fontWeight": 600, "lineHeight": 58, "letterSpacing": "0" },
      "headline-lg-rtl":         { "fontFamily": "Vazirmatn", "fontSize": 32, "fontWeight": 600, "lineHeight": 48, "letterSpacing": "0" },
      "headline-lg-mobile-rtl":  { "fontFamily": "Vazirmatn", "fontSize": 24, "fontWeight": 600, "lineHeight": 38, "letterSpacing": "0" },
      "headline-md-rtl":         { "fontFamily": "Vazirmatn", "fontSize": 24, "fontWeight": 500, "lineHeight": 38, "letterSpacing": "0" },
      "title-md-rtl":            { "fontFamily": "Vazirmatn", "fontSize": 18, "fontWeight": 600, "lineHeight": 29, "letterSpacing": "0" },
      "title-sm-rtl":            { "fontFamily": "Vazirmatn", "fontSize": 16, "fontWeight": 600, "lineHeight": 26, "letterSpacing": "0" },
      "body-md-rtl":             { "fontFamily": "Vazirmatn", "fontSize": 16, "fontWeight": 400, "lineHeight": 29, "letterSpacing": "0" },
      "body-sm-rtl":             { "fontFamily": "Vazirmatn", "fontSize": 14, "fontWeight": 400, "lineHeight": 24, "letterSpacing": "0" },
      "label-md-rtl":            { "fontFamily": "Vazirmatn", "fontSize": 14, "fontWeight": 500, "lineHeight": 24, "letterSpacing": "0" },
      "label-sm-rtl":            { "fontFamily": "Vazirmatn", "fontSize": 12, "fontWeight": 600, "lineHeight": 19, "letterSpacing": "0" },
      "label-sm-mobile-rtl":     { "fontFamily": "Vazirmatn", "fontSize": 10, "fontWeight": 600, "lineHeight": 16, "letterSpacing": "0" }
    },
    "fontFamilies": {
      "Geist": { "weights": [400, 500, 600, 700], "role": "headings, labels, buttons (LTR) — not yet bundled, falls back to system font" },
      "Inter": { "weights": [400, 500, 600], "role": "body copy (LTR) — not yet bundled, falls back to system font" },
      "Vazirmatn": { "weights": [400, 500, 600, 700], "role": "all text (RTL/Persian) — bundled, the only typeface actually shipped" },
      "AZAR Icon Set": { "weights": "n/a — stroke-based, not a font", "role": "iconography, all contexts; zero-dependency pure-View composition, see design-system.md §6" }
    }
  },
  "spacing": {
    "space-0": 0,
    "space-1": 4,
    "space-2": 8,
    "space-3": 12,
    "space-4": 16,
    "space-5": 20,
    "space-6": 24,
    "space-8": 32,
    "space-10": 40,
    "space-12": 48,
    "space-16": 64,
    "semantic": {
      "base": "space-2",
      "gutter": "space-4",
      "margin-mobile": "space-4",
      "margin-desktop": "space-8",
      "compact-gutter": "space-3",
      "relaxed-gutter": "space-6",
      "container-max-width": 1200
    }
  },
  "radius": {
    "radius-none": 0,
    "radius-small": 4,
    "radius-medium": 8,
    "radius-large": 12,
    "radius-extra-large": 20,
    "radius-full": 9999,
    "radius-container-lg": 24
  },
  "elevation": {
    "elevation-0": { "shadow": "none", "border": "1px solid var(--outline-variant)" },
    "elevation-1": { "shadow": "0 6px 20px rgba(28,27,25,0.05)" },
    "elevation-2": { "shadow": "0 2px 6px rgba(28,27,25,0.08)" },
    "elevation-3": { "shadow": "0 16px 32px -8px rgba(28,27,25,0.12)" },
    "elevation-4": { "shadow": "0 20px 40px rgba(28,27,25,0.18)" }
  },
  "icon": {
    "icon-2xs": 14,
    "icon-xs": 16,
    "icon-sm": 18,
    "icon-md": 24,
    "icon-lg": 32,
    "icon-xl": 48,
    "family": "AZAR Icon Set (hand-drawn, zero-dependency)",
    "defaultFill": 0,
    "activeFill": 1
  },
  "motion": {
    "duration-fast": 150,
    "duration-standard": 200,
    "duration-moderate": 300,
    "easing-standard": "cubic-bezier(0.4, 0, 0.2, 1)",
    "pressScale": 0.98
  },
  "touchTarget": {
    "minimum": 48,
    "unit": "dp"
  },
  "grid": {
    "compact":  { "minWidth": 0,   "maxWidth": 599,  "columns": 4,  "margin": "space-4", "gutter": "space-4" },
    "medium":   { "minWidth": 600, "maxWidth": 839,  "columns": 8,  "margin": "space-6", "gutter": "space-4" },
    "expanded": { "minWidth": 840, "maxWidth": null, "columns": 12, "margin": "space-8", "gutter": "space-6" },
    "contentMaxWidth": 1200
  },
  "layout": {
    "topAppBarHeight": 64,
    "bottomNavHeight": 80,
    "sheetMaxWidthDesktop": 480
  },
  "component": {
    "button": { "paddingY": ["space-3", "space-4"], "paddingX": "space-6", "radius": "radius-large", "typography": "label-md" },
    "iconButton": { "visualIconSize": 24, "hitArea": 48, "hitAreaRequired": true, "radius": "radius-full", "note": "Every icon-only interactive control uses a 48dp x 48dp minimum interactive container regardless of the visual icon's own size; the icon itself is never enlarged to fill the container." },
    "textField": { "paddingY": "space-3", "paddingX": "space-4", "radius": "radius-large", "labelTypography": "label-md", "valueTypography": "body-md" },
    "chip": { "paddingY": "space-1", "paddingX": "space-3", "radius": "radius-full", "typography": "label-sm" },
    "card": { "radiusListItem": "radius-large", "radiusDetail": "radius-extra-large", "paddingDetail": "space-8", "paddingListItem": "space-5" },
    "bottomSheet": { "radiusCompact": "radius-container-lg", "maxWidthDesktop": 480, "handleWidth": 40, "handleHeight": 4 },
    "listRow": { "minHeight": 56, "maxHeight": 72, "paddingX": "space-4", "paddingY": "space-3" },
    "priorityChip": {
      "MUST_HAVE": { "bg": "primary", "fg": "on-primary" },
      "IMPORTANT": { "bg": "secondary-container", "fg": "on-secondary-container" },
      "PREFERRED": { "bg": "surface-container-high", "fg": "primary" },
      "IGNORE": { "bg": "surface-container-low", "fg": "on-surface-variant", "border": "outline-variant" }
    }
  }
}
