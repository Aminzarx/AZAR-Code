# EYVAN sign-in server (azar-auth) — environment names only. Copy to a file OUTSIDE the repo
# (live: an EnvironmentFile read by systemd) and fill in real values. Never commit the filled file.

# --- runtime (set by the systemd unit on the live host) ---
NODE_ENV=production
PORT=8787
HOST=127.0.0.1
AZAR_DB_PATH=/opt/azar-auth/data/azar-auth.db

# --- SMS sign-in codes (Kavenegar verify/lookup) ---
KAVENEGAR_API_KEY=<kavenegar-api-key>
KAVENEGAR_OTP_TEMPLATE=<template-name>
KAVENEGAR_OTP_TEMPLATE_ID=<template-id-for-reference>
# Optional while testing: every code is this one and no SMS is sent. Remove for real SMS.
# AZAR_FIXED_OTP_CODE=123456
# Optional: comma-separated test phone numbers that get the test code / test sales path
AZAR_TEST_OTP_NUMBERS=
AZAR_TOKEN_SALES_TEST_NUMBERS=

# --- keys made by you (generate fresh ones; never reuse the live ones) ---
# 32 random bytes, base64 — encrypts each account's synced data and office data
AZAR_SYNC_KEY=<base64-32-bytes>
# Ed25519 private key that signs licences; its public half is LICENCE_PUBLIC_KEY in src/infrastructure/licence/licenceToken.ts
AZAR_LICENCE_KEY=<ed25519-private-key>
# Shared with the billing service: signs purchase confirmations
AZAR_PURCHASE_SECRET=<random-secret>
# Shared with the panel that opens the office dashboard by single sign-on
AZAR_OFFICE_SSO_SECRET=<random-secret>
# Admin API key (or AZAR_ADMIN_KEY_FILE=/path, or systemd LoadCredential eyvan-admin.key)
AZAR_ADMIN_KEY=<random-secret>

# --- licences / plans ---
AZAR_LICENCE_ALL_FREE=1
AZAR_LICENCE_FREE_NUMBERS=
KSS_PRICING_URL=<pricing-service-url>
KSS_PRICING_KEY=<pricing-service-key>

# --- token sales through the billing service ---
AZAR_BILLING_URL=<billing-api-url>
AZAR_BILLING_KEY=<billing-key-for-eyvan>
# 1 = real money; anything else = payment gateway sandbox
AZAR_TOKEN_SALES_LIVE=0

# --- optional, with defaults in code ---
# AZAR_PUBLIC_BASE_URL=https://eyvan.kssx.ir
# AZAR_INVITE_ARTICLE_URL=
# AZAR_SUPPORT_PREFIX=پشتیبانی اپلیکیشن ایوان
# AZAR_SUPPORT_TELEGRAM= / AZAR_SUPPORT_WHATSAPP= / AZAR_SUPPORT_RUBIKA=
# AZAR_SYNC_BLOB_DIR= / AZAR_SYNC_QUOTA_BYTES=50000000
# EYVAN_BACKUP_DIR=/root/kss-backups/eyvan-nightly
# DIVAR_POST_URL=https://api.divar.ir/v8/posts-v2/web
