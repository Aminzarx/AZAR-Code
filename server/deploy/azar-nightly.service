# Amin #5197: purge due deletions + one encrypted backup zip per account (src/nightly.js); Drive upload runs on the PC.
[Unit]
Description=EYVAN nightly backup and purge (azar-auth)
After=azar-auth.service

[Service]
Type=oneshot
User=azar-auth
WorkingDirectory=/opt/azar-auth
Environment=NODE_ENV=production AZAR_DB_PATH=/opt/azar-auth/data/azar-auth.db EYVAN_BACKUP_DIR=/var/backups/eyvan-nightly
EnvironmentFile=/root/kss-secrets/azar-auth.env
EnvironmentFile=/root/kss-secrets/eyvan-backup.env
ExecStart=/usr/bin/node src/nightly.js
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/azar-auth/data /var/backups/eyvan-nightly
ProtectHome=true
PrivateTmp=true
