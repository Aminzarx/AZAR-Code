<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!-- Amin #5299: native dialogs, pickers and menus in the app font too -->
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
        <!-- Amin #4936: the logo shows from the very first moment, then the JS splash takes over in the same place -->
        <item name="android:windowBackground">@drawable/splash_background</item>
        <!-- Amin #5055: bars in the app's background colour, icons dark on light and light on dark -->
        <item name="android:statusBarColor">@color/bar_background</item>
        <item name="android:navigationBarColor">@color/bar_background</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_bars</item>
    </style>

</resources>
