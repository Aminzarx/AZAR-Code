{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest", "node"],
    "baseUrl": ".",
    "paths": {
      "@app/*": ["src/app/*"],
      "@navigation/*": ["src/navigation/*"],
      "@core/*": ["src/core/*"],
      "@features/*": ["src/features/*"],
      "@shared/*": ["src/shared/*"],
      "@infrastructure/*": ["src/infrastructure/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "index.js", "*.d.ts"],
  "exclude": ["node_modules", "android", "ios"]
}
